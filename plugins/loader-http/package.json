  "dependencies": {
    "@edv4h/alter-ego-core": "workspace:^",
    "@edv4h/alter-ego-schema": "workspace:^"
  },
  "devDependencies": {
    "msw": "^3.0.5",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
