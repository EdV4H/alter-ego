{
  "name": "@edv4h/alter-ego-plugin-loader-http",
  "version": "0.1.0",
  "description": "HTTP loader plugin for alter-ego.",
  "license": "MIT",
  "author": "Yusuke Maruyama",
  "keywords": [
    "avatar",
    "headless",
    "schema",
    "alter-ego"
  ],
  "homepage": "https://github.com/EdV4H/alter-ego/tree/main/plugins/loader-http#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdV4H/alter-ego.git",
    "directory": "plugins/loader-http"
  },
  "bugs": {
    "url": "https://github.com/EdV4H/alter-ego/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
