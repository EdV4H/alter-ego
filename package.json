{
  "name": "alter-ego",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" --filter=\"./plugins/*\" run build",
    "dev": "pnpm -r --parallel --filter=\"./packages/*\" --filter=\"./plugins/*\" run dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @alter-ego/app-react-web test:e2e",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxlint --fix",
    "lint:pkg": "pnpm -r --filter=\"./packages/*\" --filter=\"./plugins/*\" exec pnpm dlx publint@0.3.25 --strict",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && node scripts/publish-packages.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "oxlint": "^1.93.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
