{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@edv4h/alter-ego-core": ["../../packages/core/src/index.ts"],
      "@edv4h/alter-ego-perceive": ["../../packages/perceive/src/index.ts"],
      "@edv4h/alter-ego-schema": ["../../packages/schema/src/index.ts"],
      "@edv4h/alter-ego-plugin-loader-http": ["../../plugins/loader-http/src/index.ts"],
      "@edv4h/alter-ego-plugin-renderer-svg": ["../../plugins/renderer-svg/src/index.ts"],
      "@edv4h/alter-ego-react": ["../../packages/react/src/index.ts"]
