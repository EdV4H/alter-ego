{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/@edv4h/alter-ego-schema@1/schema/avatar.schema.json",
  "title": "AvatarSchema",
  "description": "alter-ego のアバター構成を宣言するスキーマ。docs/schema.md を参照",
  "type": "object",
  "required": [
    "schemaVersion",
    "metadata",
    "slots",
    "parts",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "description": "スキーマ形式のバージョン。MAJOR.MINOR（ADR-0010）",
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "canvas": {
      "$ref": "#/$defs/Canvas"
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Slot"
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Part"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Asset"
      }
    },
    "groups": {
      "description": "複数の Slot を 1 単位として扱う宣言（ADR-0007）",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SlotGroup"
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "Color": {
      "description": "hex 形式の色（#RGB / #RGBA / #RRGGBB / #RRGGBBAA）",
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "RenamedFrom": {
      "description": "以前の id。保存した AvatarState を読み込むとき、旧 id を今の id に読み替える。新しいものから順に並べる（ADR-0012）",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      },
      "minItems": 1,
      "uniqueItems": true,
      "tsType": "string[]"
    },
    "Metadata": {
      "title": "Metadata",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "Canvas": {
      "title": "Canvas",
      "description": "描画座標系。Slot の配置と変形はこの座標系の値で書く（ADR-0009）",
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "Placement": {
      "title": "Placement",
      "description": "Slot の既定の配置。canvas 座標系での位置・大きさ・回転（度）。省略時は canvas 全体（ADR-0009）",
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "Slot": {
      "title": "Slot",
      "type": "object",
      "required": [
        "id",
        "name",
        "zIndex"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "renamedFrom": {
          "$ref": "#/$defs/RenamedFrom"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "description": "人間にも AI にも読める説明。perceive のプロンプトにも使う（ADR-0011）",
          "type": "string"
        },
        "zIndex": {
          "type": "number"
        },
        "required": {
          "type": "boolean"
        },
        "category": {
          "type": "string"
        },
        "palette": {
          "description": "この Slot で選べる色の候補。UI と perceive が参照する。Selection.color が候補外でもエラーにしない（ADR-0008）",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Color"
          },
          "tsType": "string[]"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "SlotGroup": {
      "title": "SlotGroup",
      "description": "複数の Slot を 1 単位として扱う宣言。slots の先頭が基準 Slot（ADR-0007）",
      "type": "object",
      "required": [
        "id",
        "name",
        "slots"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "slots": {
          "description": "グループに属する Slot の id。先頭が基準 Slot",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "uniqueItems": true,
          "tsType": "string[]"
        },
        "linkParts": {
          "description": "基準 Slot の選択に合わせて、他の Slot から同じ pairKey の Part を選ぶか。既定 true",
          "type": "boolean"
        },
        "linkColor": {
          "description": "基準 Slot の color を他の Slot にもそろえるか。既定 true",
          "type": "boolean"
        },
        "mirror": {
          "description": "変形を鏡像で連動させるか（ADR-0009）。既定 false",
          "type": "boolean"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "Part": {
      "title": "Part",
      "type": "object",
      "required": [
        "id",
        "slotId",
        "name",
        "assetId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "renamedFrom": {
          "$ref": "#/$defs/RenamedFrom"
        },
        "slotId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "description": "人間にも AI にも読める説明。perceive のプロンプトにも使う（ADR-0011）",
          "type": "string"
        },
        "assetId": {
          "type": "string"
        },
        "colorable": {
          "type": "boolean"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Variant"
          }
        },
        "pairKey": {
          "description": "SlotGroup 内で対応する Part を引くキー。同じグループの別 Slot で同じ値を持つ Part が対応する（ADR-0007）",
          "type": "string",
          "minLength": 1
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "Variant": {
      "title": "Variant",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "renamedFrom": {
          "$ref": "#/$defs/RenamedFrom"
        },
        "overrides": {
          "$ref": "#/$defs/VariantOverrides"
        }
      },
      "additionalProperties": false
    },
    "VariantOverrides": {
      "title": "VariantOverrides",
      "type": "object",
      "properties": {
        "color": {
          "$ref": "#/$defs/Color"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "Asset": {
      "title": "Asset",
      "type": "object",
      "required": [
        "id",
        "kind",
        "src"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "description": "素材の種類。svg / image / 3d / text 以外も許容する",
          "type": "string",
          "tsType": "\"svg\" | \"image\" | \"3d\" | \"text\" | (string & {})"
        },
        "src": {
          "type": "string"
        },
        "hints": {
          "description": "Renderer が使うヒント（サイズ・配置原点等）",
          "type": "object",
          "tsType": "Record<string, unknown>"
        },
        "colorBindings": {
          "description": "アセット内の着色領域と、色を取る Slot の宣言（ADR-0008）",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ColorBinding"
          }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "ColorBinding": {
      "title": "ColorBinding",
      "description": "アセット内の 1 つの着色領域。from の先頭から順に見て、最初に color を持つ Slot の色を使う（ADR-0008）",
      "type": "object",
      "required": [
        "target",
        "from"
      ],
      "properties": {
        "target": {
          "description": "アセット内の領域を指す値。解釈は Renderer が決める（renderer-svg では置換元の hex）",
          "type": "string",
          "minLength": 1
        },
        "from": {
          "description": "色を取る Slot の id の優先順。\"self\" はこの Part が入っている Slot",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "tsType": "string[]"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "SelectionEntry": {
      "title": "SelectionEntry",
      "description": "Slot に対する Part の選択（AvatarState の要素）",
      "type": "object",
      "required": [
        "partId"
      ],
      "properties": {
        "partId": {
          "type": "string"
        },
        "variantId": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/Color"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "SlotTransform": {
      "title": "SlotTransform",
      "description": "Slot ごとの変形（AvatarState の要素、ADR-0009）。中心を保って拡縮し、その後に移動と回転を行う",
      "type": "object",
      "required": [
        "dx",
        "dy",
        "scale",
        "rotation"
      ],
      "properties": {
        "dx": {
          "description": "canvas 座標系での横の移動量",
          "type": "number"
        },
        "dy": {
          "description": "canvas 座標系での縦の移動量",
          "type": "number"
        },
        "scale": {
          "description": "拡縮率。0.3〜3.0",
          "type": "number",
          "minimum": 0.3,
          "maximum": 3
        },
        "rotation": {
          "description": "回転（度）。-180〜180",
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    }
  }
}
