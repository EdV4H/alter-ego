{
  "name": "@edv4h/alter-ego-vue",
  "version": "0.0.0",
  "private": true,
  "description": "Vue bindings for alter-ego.",
  "license": "MIT",
  "keywords": [
    "avatar",
    "headless",
    "schema",
    "alter-ego"
  ],
  "homepage": "https://github.com/EdV4H/alter-ego/tree/main/packages/vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdV4H/alter-ego.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/EdV4H/alter-ego/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@edv4h/alter-ego-core": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vue": "^3.5.45"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
