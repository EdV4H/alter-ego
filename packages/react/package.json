{
  "name": "@edv4h/alter-ego-react",
  "version": "0.1.1",
  "description": "React hooks for alter-ego.",
  "license": "MIT",
  "author": "Yusuke Maruyama",
  "keywords": [
    "avatar",
    "headless",
    "schema",
    "alter-ego"
  ],
  "homepage": "https://github.com/EdV4H/alter-ego/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdV4H/alter-ego.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/EdV4H/alter-ego/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@edv4h/alter-ego-core": "workspace:^",
    "@edv4h/alter-ego-schema": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.0.0",
    "tsdown": "^0.21.9",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
